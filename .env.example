# Required for model requests in local and deployed environments.
OPENROUTER_API_KEY=

# Default starter mode. Use a strong value (16+ characters recommended).
EVE_CHAT_PASSWORD=

# Optional production mode. Configure every value in this section to switch
# from browser storage/password auth to Neon, Upstash, and Sign in with Vercel.
DATABASE_URL=
BETTER_AUTH_SECRET=
NEXT_PUBLIC_VERCEL_APP_CLIENT_ID=
VERCEL_APP_CLIENT_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: override the app origin for a custom production domain.
BETTER_AUTH_URL=

# Optional: enable the hosted Slack channel.
SLACK_CONNECTOR=

# Optional marketing integrations used by specialists in this same chat.
# Create connectors with these names or set their returned UIDs here.
NOTION_CONNECTOR=notion/marketing-team
RESEND_CONNECTOR=resend/marketing-team
TYPEFULLY_API_KEY=
BLOB_READ_WRITE_TOKEN=
